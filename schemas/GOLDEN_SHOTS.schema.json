{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-to-comic-engine.local/schemas/GOLDEN_SHOTS.schema.json",
  "title": "Golden Shots Regression Manifest",
  "description": "已人工审阅并有 SHA-256、ffprobe、完整解码证据的媒体回归样本清单。该清单不是视觉质量自动判定器。",
  "type": "object",
  "required": ["manifest_version", "project_id", "records"],
  "properties": {
    "manifest_version": {"type": "string", "const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/GoldenShot"}
    }
  },
  "$defs": {
    "GoldenShot": {
      "type": "object",
      "required": ["record_id", "artifact_path", "sha256", "review_status", "evidence_refs", "expected_media"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_\\-]+$"},
        "artifact_path": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_status": {"type": "string", "enum": ["accepted", "candidate", "blocked"]},
        "review_basis": {"type": "string"},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+"}
        },
        "expected_media": {
          "type": "object",
          "required": ["duration_sec", "width", "height", "fps_num", "fps_den", "video_codec", "audio_codec"],
          "properties": {
            "duration_sec": {"type": "number", "minimum": 0},
            "duration_tolerance_sec": {"type": "number", "minimum": 0},
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1},
            "fps_num": {"type": "integer", "minimum": 1},
            "fps_den": {"type": "integer", "minimum": 1},
            "video_codec": {"type": "string"},
            "audio_codec": {"type": "string"},
            "complete_decode": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "generation": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
