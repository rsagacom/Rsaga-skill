# Compose 默认以 production 模式启动；以下占位凭据会被 config-check 拒绝。
# 生产请通过 secret manager 注入真实值，不要提交真实值；仅本地开发可直接运行 SQLite API。
POSTGRES_DB=manhua_studio
POSTGRES_USER=manhua
POSTGRES_PASSWORD=change-me-local-only
# 生产发布应显式 pin 这些镜像；升级需单独变更并重跑 runtime/stack gate。
POSTGRES_IMAGE=postgres:16.4-alpine
REDIS_IMAGE=redis:7.2-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
MINIO_ROOT_USER=minio-local
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_BUCKET=manhua-assets
# Optional production edge overlay (infra/docker-compose.edge.yml). Caddy
# obtains/renews HTTPS certificates for this host; do not use example values.
STUDIO_PUBLIC_HOST=studio.example.com
ACME_EMAIL=ops@example.com
CADDY_IMAGE=caddy:2.11.4-alpine
STUDIO_INTERNAL_TOKEN=local-internal-only-change-me
ORCHESTRATOR_TOKEN=local-orchestrator-only-change-me
# 生产 Compose 固定为 true；直接本地启动编排器时默认 false 以保留开发兼容模式。
ORCHESTRATOR_REQUIRE_AUTH=true
ORCHESTRATOR_MAX_BODY_BYTES=65536
STUDIO_MAX_BODY_BYTES=16777216
# production 由 Compose 固定为 true；这里显式写出安全合同。
STUDIO_REQUIRE_AUTH=true
STUDIO_AUTH_COOKIE_SECURE=true
STUDIO_ALLOW_LOCAL_TOP_UP=true
# 本地默认不创建充值订单；生产可使用 signed-webhook 或 stripe。
STUDIO_BILLING_PROVIDER=disabled
# STUDIO_BILLING_WEBHOOK_SECRET=
# 生产必填：部署方 checkout adapter 的 HTTPS/受控入口；订单参数由服务端追加，入账仍只信任签名 webhook。
# STUDIO_BILLING_CHECKOUT_URL=https://pay.example.test/checkout
# Stripe 模式生产必填：secret manager 注入两项 secret；不要写入本文件或项目数据库。
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_API_BASE_URL=https://api.stripe.com
# STUDIO_BILLING_SUCCESS_URL=https://studio.example.test/billing/success
# STUDIO_BILLING_CANCEL_URL=https://studio.example.test/billing/cancel
# 生产 config-check 拒绝 local preview，要求文本/视觉 openai-compatible 和图片/视频 ComfyUI
STUDIO_TEXT_PROVIDER=local
STUDIO_IMAGE_PROVIDER=local
STUDIO_VIDEO_PROVIDER=local
STUDIO_VISION_PROVIDER=local
# The public edge host must be present here; loopback hosts keep container
# health checks and local maintenance probes working.
STUDIO_ALLOWED_HOSTS=studio.example.com,localhost,127.0.0.1
STUDIO_CORS_ORIGINS=https://studio.example.com
STUDIO_RATE_LIMIT_PER_MINUTE=120
STUDIO_RATE_LIMIT_REDIS_URL=redis://redis:6379
STUDIO_RATE_LIMIT_FAIL_CLOSED=false
STUDIO_OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-manhua-studio-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# 生产由 secret manager 注入，格式为 key=value,key2=value2；不要写入真实 token。
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<collector-token>
STUDIO_TEXT_PROVIDER=local
STUDIO_TEXT_BASE_URL=http://127.0.0.1:8000/v1
STUDIO_TEXT_MODEL=local-model
STUDIO_TEXT_API_KEY_ENV=STUDIO_TEXT_API_KEY
# 生产由 secret manager 注入；不要把真实 key 写入此文件。
# STUDIO_TEXT_API_KEY=
STUDIO_IMAGE_PROVIDER=local
STUDIO_VIDEO_PROVIDER=local
STUDIO_VISION_PROVIDER=local
STUDIO_VISION_BASE_URL=http://127.0.0.1:8000/v1
STUDIO_VISION_MODEL=local-vision-model
STUDIO_VISION_API_KEY_ENV=STUDIO_VISION_API_KEY
# STUDIO_VISION_API_KEY=
STUDIO_SPEECH_PROVIDER=local
STUDIO_SPEECH_BASE_URL=https://api.openai.com/v1
STUDIO_SPEECH_MODEL=gpt-4o-mini-tts-2025-12-15
STUDIO_SPEECH_API_KEY_ENV=OPENAI_API_KEY
# 可选：只允许这些内置音色；默认值与 OpenAI Audio API 内置音色合同一致。
STUDIO_SPEECH_ALLOWED_VOICES=cedar,marin,alloy,ash,ballad,coral,echo,fable,nova,onyx,sage,shimmer,verse
# 生产由 secret manager 注入；OpenAI 语音 key 不写入此文件。
# OPENAI_API_KEY=
COMFYUI_BASE_URL=http://127.0.0.1:8188
# 生成媒体下载硬上限，默认 256 MiB，服务端强制不超过 2 GiB；避免异常 workflow 无界读入 Worker 内存。
COMFYUI_OUTPUT_MAX_BYTES=268435456
# 启用 ComfyUI 时设置为 API 容器内可见的 workflow JSON 路径。
COMFYUI_IMAGE_WORKFLOW=
COMFYUI_VIDEO_WORKFLOW=
# 可选：限制用户 provider 偏好只能指向这些已批准的无凭据 URL，逗号分隔。
# STUDIO_ALLOWED_PROVIDER_BASE_URLS=http://comfyui:8188,https://text.example.com/v1
# Production edge uses same-origin HTTPS; local preview overrides this in
# infra/docker-compose.dev.yml instead of weakening the production example.
# Production default is same-origin: the HTTPS ingress must route /api and
# /assets to the API service. Set an explicit https:// API origin only when
# the API is intentionally served from a separate public domain. The dev
# Compose override supplies http://localhost:8787 for local preview.
NEXT_PUBLIC_API_BASE=
STUDIO_QUEUE_BACKEND=bullmq
STUDIO_ORCHESTRATOR_URL=http://orchestrator:8790
STUDIO_JOB_STALE_SECONDS=1800
# 可选：remotion 需要 API 镜像中的 Node/Chrome 运行时；默认 ffmpeg。
STUDIO_COMPOSE_ENGINE=ffmpeg
# 可选：覆盖 Remotion Chrome/Chromium 路径；未设置时使用官方 ensureBrowser 自动准备的浏览器。
STUDIO_REMOTION_BROWSER_EXECUTABLE=
